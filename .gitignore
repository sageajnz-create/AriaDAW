# Engine is vendored by scripts/setup.sh, not committed.
# It's a build dependency (like node_modules), and the GGUF weights are ~5.6 GB.
/engine/acestep.cpp/

# Model weights — never commit these.
*.gguf
*.safetensors

# Generated audio and user library
/output/
*.wav
*.mp3
*.flac

# Rust / Tauri
/src-tauri/target/
/src-tauri/gen/

# Node
node_modules/
dist/
dist-ssr/
*.local

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
.directory
*.swp

# Phase 0 scratch output
/output/

# Sidecar staged by scripts/setup.sh and scripts/package.sh
/src-tauri/binaries/
/src-tauri/resources/engine/

# Linux package outputs (the .deb/.AppImage live under src-tauri/target/,
# which is already ignored). Flatpak-builder's working copy of the .deb,
# the ostree repo, and the bundled .flatpak must not be committed.
/packaging/flatpak/aria.deb
/packaging/flatpak/build/
/packaging/flatpak/repo/
/packaging/flatpak/.flatpak-builder/
/packaging/*.flatpak
