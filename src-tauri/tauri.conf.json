{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aria",
  "version": "0.1.0",
  "identifier": "org.aria.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aria",
        "width": 1600,
        "height": 1100,
        "minWidth": 640,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$AUDIO/Aria/**",
          "$APPDATA/audio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "Free, unlimited, local AI music creation",
    "longDescription": "Aria generates complete songs with vocals entirely on your own computer. No account, no credits, no subscription. Everything you make is yours.",
    "resources": {},
    "externalBin": [
      "binaries/ace-server"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "libvulkan1",
          "mesa-vulkan-drivers"
        ]
      }
    }
  }
}
